{
  "name": "@imio/pat-wallonia-map",
  "version": "1.0.0",
  "private": true,
  "description": "Map of Wallonia pattern for Plone 6 Classic UI",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMIO/imio.map.wallonia.git"
  },
  "main": "resources/pat-wallonia-map/wallonia-map.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "start": "NODE_ENV=development webpack serve --config webpack.config.js",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --watch",
    "test": "jest",
    "lint": "eslint resources"
  },
  "dependencies": {
    "@patternslib/patternslib": "9.10.7",
    "@plone/mockup": "5.6.10",
    "@react-leaflet/core": "3.0.0",
