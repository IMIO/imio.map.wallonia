    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@patternslib/dev": "^4.3.0"
  },
  "overrides": {
    "@patternslib/patternslib": "$@patternslib/patternslib",
    "jquery": "3.7.1"
  },
  "keywords": [
    "patternslib",
    "mockup",
    "plone",
    "leaflet",
