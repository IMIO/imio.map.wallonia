<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
>
  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">
        <!-- Demo only. Each link text is the French name of a municipality. -->
        <div class="pat-wallonia-map">
          <ul hidden="hidden"
              data-layer="municipalities"
          >
            <li><a href="https://example.org/namur">Namur</a></li>
            <li><a href="https://example.org/liege">Li&egrave;ge</a></li>
            <li><a href="https://example.org/charleroi">Charleroi</a></li>
            <li><a href="https://example.org/mons">Mons</a></li>
            <li><a href="https://example.org/arlon">Arlon</a></li>
            <li><a href="https://example.org/wavre">Wavre</a></li>
          </ul>
        </div>
      </metal:block>
    </metal:content-core>

  </body>
</html>
